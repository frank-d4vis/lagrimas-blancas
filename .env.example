# Copia este archivo como .env (local) o cárgalo en "Environment" de Render/Vercel
NODE_ENV=production
PORT=3000
# Supabase > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres.xxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Cadena larga y aleatoria:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio

# ---- WhatsApp (OPCIONALES: si faltan se usan valores de ejemplo) ----
# Número oficial de coordinación, con código de país y solo dígitos (Perú = 51)
WHATSAPP_NUMBER=51999000000
# Cómo se muestra el número en pantalla
WHATSAPP_DISPLAY=+51 999 000 000
# Enlace de invitación al grupo de acogida de voluntarios
WHATSAPP_GROUP_URL=https://chat.whatsapp.com/REEMPLAZAR_CODIGO_DEL_GRUPO
