<%- include('../../partials/header', { title: 'Gestión de campañas' }) %>
<section class="container py-5">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h2 section-title mb-0">Campañas</h1>
    <a href="/admin/campanas/nueva" class="btn btn-cta">+ Nueva campaña</a>
  </div>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead><tr><th>Título</th><th>Recaudado / Meta</th><th>Avance</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
      <tbody>
        <% if (campaigns.length === 0) { %><tr><td colspan="5" class="text-center text-muted">Sin campañas registradas.</td></tr><% } %>
        <% campaigns.forEach(function (c) { %>
          <tr>
            <td><%= c.title %></td>
            <td><%= money(c.current_amount) %> / <%= money(c.goal_amount) %></td>
            <td><%= pct(c.current_amount, c.goal_amount) %>%</td>
            <td><span class="badge <%= c.status === 'active' ? 'bg-lb-teal' : 'bg-secondary' %>"><%= statusLabel(c.status) %></span></td>
            <td class="text-end text-nowrap">
              <a class="btn btn-sm btn-outline-lb" href="/admin/campanas/<%= c.id %>/editar">Editar</a>
              <form method="post" action="/admin/campanas/<%= c.id %>" class="d-inline" data-confirm="¿Eliminar la campaña «<%= c.title %>»? Esta acción no se puede deshacer.">
                <%- include('../../partials/csrf') %>
                <input type="hidden" name="_method" value="DELETE">
                <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../../partials/footer') %>
