<%- include('../../partials/header', { title: 'Administradores' }) %>
<section class="container py-4 py-md-5">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h2 section-title mb-0">Administradores</h1>
    <a href="/admin/administradores/nuevo" class="btn btn-cta">+ Cuenta de respaldo</a>
  </div>
  <p class="small text-muted">Las cuentas de respaldo (rol admin) evitan depender de una sola persona. Solo el superadministrador puede crearlas.</p>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Creada</th></tr></thead>
      <tbody>
        <% admins.forEach(function (a) { %>
          <tr>
            <td><%= a.name %></td>
            <td><%= a.email %></td>
            <td><span class="badge <%= a.role === 'superadmin' ? 'bg-magenta' : 'bg-lb-teal' %>"><%= a.role %></span></td>
            <td><%= fdate(a.created_at) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../../partials/footer') %>
