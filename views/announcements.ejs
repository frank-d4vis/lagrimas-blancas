<%- include('partials/header', { title: 'Comunicados' }) %>
<section class="container py-5">
  <h1 class="h2 section-title">Tablón de comunicados oficiales</h1>
  <nav class="d-flex flex-wrap gap-2 mb-4" aria-label="Filtrar por categoría">
    <a class="btn btn-outline-lb <%= !category ? 'active' : '' %>" href="/comunicados">Todos</a>
    <% categories.forEach(function (c) { %>
      <a class="btn btn-outline-lb <%= category === c ? 'active' : '' %>" href="/comunicados?category=<%= encodeURIComponent(c) %>"><%= c %></a>
    <% }) %>
  </nav>
  <% if (items.length === 0) { %>
    <div class="alert alert-info">No hay comunicados en esta categoría.</div>
  <% } %>
  <div class="row g-4">
    <% items.forEach(function (a) { %>
      <div class="col-12 col-lg-6">
        <article class="card card-lb">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
              <span class="badge <%= catBadge(a.category) %>"><%= a.category %></span>
              <time class="small text-muted" datetime="<%= new Date(a.published_at).toISOString() %>"><%= fdate(a.published_at) %></time>
            </div>
            <h2 class="h5 text-lb mt-2"><%= a.title %></h2>
            <p class="preline mb-0"><%= a.content %></p>
          </div>
        </article>
      </div>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>
