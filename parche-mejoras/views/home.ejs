<%- include('partials/header', { title: 'Inicio' }) %>
<section class="hero py-5">
  <div class="container py-3">
    <div class="row">
      <div class="col-lg-8">
        <h1 class="display-6 display-md-5">Cada gota cuenta: unidos por las familias de Arequipa</h1>
        <p class="lead">Conectamos donantes, voluntarios y comunidades. Todo con transparencia.</p>
        <div class="d-flex flex-wrap gap-2">
          <a href="/donar" class="btn btn-cta btn-lg">Donar ahora</a>
          <a href="/voluntariado" class="btn btn-cta btn-lg">Ser voluntario</a>
          <a href="/campanas" class="btn btn-outline-light btn-lg">Ver campañas</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="container py-5">
  <h2 class="section-title h3">Campañas activas</h2>
  <% if (campaigns.length === 0) { %>
    <p class="text-muted">Por ahora no hay campañas activas.</p>
  <% } else { %>
    <div class="row g-4">
      <% campaigns.forEach(function (c) { %>
        <div class="col-12 col-md-6 col-lg-4"><%- include('partials/campaign-card', { c: c }) %></div>
      <% }) %>
    </div>
  <% } %>
  <p class="mt-3"><a href="/campanas">Ver todas las campañas</a></p>
</section>

<section class="bg-lb-gray py-5" id="evidencias">
  <div class="container">
    <h2 class="section-title h3">Campañas culminadas · Evidencias de entregas</h2>
    <p>Así usamos cada donación. Mira las fotos de lo que ya entregamos.</p>
    <% if (completed.length === 0) { %>
      <p class="text-muted">Pronto publicaremos las evidencias de nuestras primeras entregas.</p>
    <% } else { %>
      <div class="row g-4">
        <% completed.forEach(function (c) { %>
          <div class="col-12 col-md-6 col-lg-4"><%- include('partials/evidence-card', { c: c }) %></div>
        <% }) %>
      </div>
      <p class="mt-3"><a href="/campanas/archivo">Ver todas las evidencias</a></p>
    <% } %>
  </div>
</section>

<section class="container py-5">
  <h2 class="section-title h3">Últimos comunicados</h2>
  <% if (announcements.length === 0) { %>
    <p class="text-muted">Aún no hay comunicados.</p>
  <% } %>
  <div class="row g-3">
    <% announcements.forEach(function (a) { %>
      <div class="col-md-4">
        <article class="card card-lb">
          <div class="card-body">
            <span class="badge <%= catBadge(a.category) %> mb-2"><%= a.category %></span>
            <h3 class="h6 text-lb"><%= a.title %></h3>
            <p class="small text-muted mb-2"><%= fdate(a.published_at) %></p>
            <p class="small preline mb-0"><%= a.content.length > 140 ? a.content.slice(0, 140) + '…' : a.content %></p>
          </div>
        </article>
      </div>
    <% }) %>
  </div>
  <p class="mt-3"><a href="/comunicados">Ver todos los comunicados</a></p>
</section>
<%- include('partials/footer') %>
