<%- include('../../partials/header', { title: 'Nuevo administrador de respaldo' }) %>
<section class="container py-4 py-md-5">
  <div class="row justify-content-center"><div class="col-lg-6">
    <h1 class="h2 section-title">Nueva cuenta de respaldo</h1>
    <p class="small text-muted">Se creará con rol <strong>admin</strong>. La contraseña debe tener 12 o más caracteres, con mayúscula, minúscula, número y símbolo.</p>
    <%- include('../../partials/errors') %>
    <form method="post" action="/admin/administradores" novalidate>
      <%- include('../../partials/csrf') %>
      <div class="mb-3">
        <label for="name" class="form-label">Nombre *</label>
        <input class="form-control" id="name" name="name" maxlength="100" required autocomplete="off" value="<%= old.name || '' %>">
      </div>
      <div class="mb-3">
        <label for="email" class="form-label">Correo *</label>
        <input type="email" class="form-control" id="email" name="email" maxlength="150" required autocomplete="off" value="<%= old.email || '' %>">
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Contraseña inicial *</label>
        <input type="password" class="form-control" id="password" name="password" required minlength="12" autocomplete="new-password">
      </div>
      <div class="mb-3">
        <label for="confirm_password" class="form-label">Repite la contraseña *</label>
        <input type="password" class="form-control" id="confirm_password" name="confirm_password" required minlength="12" autocomplete="new-password">
      </div>
      <hr>
      <div class="mb-4">
        <label for="admin_password" class="form-label">Tu contraseña de superadministrador (confirmación) *</label>
        <input type="password" class="form-control" id="admin_password" name="admin_password" required autocomplete="current-password">
      </div>
      <button class="btn btn-lb" type="submit">Crear cuenta</button>
      <a class="btn btn-outline-secondary" href="/admin/administradores">Cancelar</a>
    </form>
  </div></div>
</section>
<%- include('../../partials/footer') %>
