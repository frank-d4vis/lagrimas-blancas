<%- include('../../partials/header', { title: 'Gestión de voluntariado' }) %>
<section class="container py-5">
  <h1 class="h2 section-title">Postulaciones de voluntariado</h1>
  <p class="small text-muted">🔒 Datos personales: visibles solo para administradores autenticados.</p>
  <nav class="d-flex flex-wrap gap-2 mb-3" aria-label="Filtrar por estado">
    <a class="btn btn-outline-lb btn-sm <%= !status ? 'active' : '' %>" href="/admin/voluntarios">Todos</a>
    <% statuses.forEach(function (s) { %>
      <a class="btn btn-outline-lb btn-sm <%= status === s ? 'active' : '' %>" href="/admin/voluntarios?status=<%= s %>"><%= statusLabel(s) %></a>
    <% }) %>
  </nav>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead><tr><th>Nombre</th><th>Contacto</th><th>Disponibilidad</th><th>Habilidades</th><th>Fecha</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
      <tbody>
        <% if (volunteers.length === 0) { %><tr><td colspan="7" class="text-center text-muted">No hay postulaciones.</td></tr><% } %>
        <% volunteers.forEach(function (v) { %>
          <tr>
            <td><%= v.full_name %></td>
            <td><a href="mailto:<%= v.email %>"><%= v.email %></a><br><span class="small"><%= v.phone %></span></td>
            <td><%= v.availability %></td>
            <td class="preline small"><%= v.skills %></td>
            <td class="small"><%= fdate(v.created_at) %></td>
            <td>
              <form method="post" action="/admin/voluntarios/<%= v.id %>/estado" class="d-flex gap-1">
                <%- include('../../partials/csrf') %>
                <input type="hidden" name="_method" value="PUT">
                <label class="visually-hidden" for="st-<%= v.id %>">Estado de <%= v.full_name %></label>
                <select class="form-select form-select-sm" id="st-<%= v.id %>" name="status">
                  <% statuses.forEach(function (s) { %>
                    <option value="<%= s %>" <%= v.status === s ? 'selected' : '' %>><%= statusLabel(s) %></option>
                  <% }) %>
                </select>
                <button class="btn btn-sm btn-lb" type="submit">OK</button>
              </form>
            </td>
            <td class="text-end">
              <form method="post" action="/admin/voluntarios/<%= v.id %>" class="d-inline" data-confirm="¿Eliminar este registro?">
                <%- include('../../partials/csrf') %>
                <input type="hidden" name="_method" value="DELETE">
                <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../../partials/footer') %>
