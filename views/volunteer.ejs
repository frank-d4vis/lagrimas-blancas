<%- include('partials/header', { title: 'Ser voluntario' }) %>
<section class="container py-4 py-md-5">
  <div class="row justify-content-center">
    <div class="col-lg-7">
      <% if (submitted) { %>
        <div class="card card-lb text-center p-4 p-md-5" role="status">
          <p class="display-4 mb-2" aria-hidden="true">✅</p>
          <h1 class="h3 text-lb">¡Postulación recibida!</h1>
          <p class="fs-5">La coordinación te responderá en un plazo máximo de <strong><%= site.responseWindow %></strong>.</p>
          <p>Mientras tanto, entra al grupo de acogida:</p>
          <a class="btn btn-whatsapp btn-lg w-100" href="<%= site.whatsappGroupUrl %>" target="_blank" rel="noopener noreferrer">Unirme ahora al grupo de WhatsApp de voluntarios</a>
          <a class="btn btn-link mt-3" href="/">Volver al inicio</a>
        </div>
      <% } else { %>
        <h1 class="h2 section-title">Postula como voluntario/a</h1>
        <p>Completa estos datos y te contactamos. Tus datos son confidenciales y nunca se muestran públicamente.</p>
        <%- include('partials/errors') %>
        <form method="post" action="/voluntariado" novalidate>
          <%- include('partials/csrf') %>
          <div class="visually-hidden" aria-hidden="true">
            <label for="website">No completar este campo</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
          </div>
          <div class="mb-3">
            <label for="full_name" class="form-label">Nombre completo *</label>
            <input type="text" class="form-control" id="full_name" name="full_name" maxlength="120" required autocomplete="name" value="<%= old.full_name || '' %>">
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="phone" class="form-label">WhatsApp / Teléfono *</label>
              <input type="tel" inputmode="tel" class="form-control" id="phone" name="phone" maxlength="20" required autocomplete="tel" value="<%= old.phone || '' %>">
            </div>
            <div class="col-md-6 mb-3">
              <label for="email" class="form-label">Correo *</label>
              <input type="email" inputmode="email" class="form-control" id="email" name="email" maxlength="150" required autocomplete="email" value="<%= old.email || '' %>">
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="district" class="form-label">Distrito / Zona en Arequipa *</label>
              <input type="text" class="form-control" id="district" name="district" maxlength="60" required list="distritos" autocomplete="address-level2" placeholder="Ej.: Cayma" value="<%= old.district || '' %>">
              <datalist id="distritos">
                <option value="Arequipa (Cercado)"><option value="Alto Selva Alegre"><option value="Cayma">
                <option value="Cerro Colorado"><option value="Jacobo Hunter"><option value="José Luis Bustamante y Rivero">
                <option value="Mariano Melgar"><option value="Miraflores"><option value="Paucarpata">
                <option value="Sachaca"><option value="Socabaya"><option value="Tiabaya">
                <option value="Uchumayo"><option value="Yanahuara"><option value="Yura">
              </datalist>
            </div>
            <div class="col-md-6 mb-3">
              <label for="availability" class="form-label">Disponibilidad *</label>
              <input type="text" class="form-control" id="availability" name="availability" maxlength="110" required placeholder="Ej.: fines de semana" value="<%= old.availability || '' %>">
            </div>
          </div>
          <div class="mb-3">
            <label for="skills" class="form-label">¿En qué puedes ayudar? *</label>
            <textarea class="form-control" id="skills" name="skills" rows="3" maxlength="500" required><%= old.skills || '' %></textarea>
          </div>
          <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" id="consent" name="consent" required <%= old.consent === 'on' ? 'checked' : '' %>>
            <label class="form-check-label" for="consent">
              Acepto que la ONG use mis datos solo para gestionar mi voluntariado (Ley N.° 29733).
            </label>
          </div>
          <button type="submit" class="btn btn-cta btn-lg w-100">Enviar postulación</button>
        </form>
      <% } %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
