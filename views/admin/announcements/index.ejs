<%- include('../../partials/header', { title: 'Gestión de comunicados' }) %>
<section class="container py-5">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h2 section-title mb-0">Comunicados</h1>
    <a href="/admin/comunicados/nuevo" class="btn btn-cta">+ Nuevo comunicado</a>
  </div>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead><tr><th>Título</th><th>Categoría</th><th>Publicado</th><th class="text-end">Acciones</th></tr></thead>
      <tbody>
        <% if (items.length === 0) { %><tr><td colspan="4" class="text-center text-muted">Sin comunicados.</td></tr><% } %>
        <% items.forEach(function (a) { %>
          <tr>
            <td><%= a.title %></td>
            <td><span class="badge <%= catBadge(a.category) %>"><%= a.category %></span></td>
            <td><%= fdate(a.published_at) %></td>
            <td class="text-end text-nowrap">
              <a class="btn btn-sm btn-outline-lb" href="/admin/comunicados/<%= a.id %>/editar">Editar</a>
              <form method="post" action="/admin/comunicados/<%= a.id %>" class="d-inline" data-confirm="¿Eliminar este comunicado?">
                <%- include('../../partials/csrf') %>
                <input type="hidden" name="_method" value="DELETE">
                <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../../partials/footer') %>
